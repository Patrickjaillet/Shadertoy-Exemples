void mainImage(out vec4 couleur_fragment, in vec2 coordonnee_fragment) {
    if (coordonnee_fragment.y > 1.0 || coordonnee_fragment.x > 6.0) {
        discard;
    }

    vec2 uv_memoire = coordonnee_fragment / iResolution.xy;
    vec4 memoire = texture(iChannel0, uv_memoire);
    
    if (iFrame == 0) {
        couleur_fragment = vec4(0.5, 0.5, 0.5, 1.0);
        return;
    }

    float index = floor(coordonnee_fragment.x);
    vec4 mise_a_jour = memoire;

    if (iMouse.z > 0.0) {
        float seuil_h = iResolution.y * 0.25;
        float limite_v = iResolution.x * 0.90;

        if (iMouse.x < limite_v && iMouse.y < seuil_h) {
            float selection = floor(iMouse.x / limite_v * 5.0);
            if (abs(selection - index) < 0.01) {
                mise_a_jour.r = clamp(iMouse.y / seuil_h, 0.0, 1.0);
            }
        }
        
        if (iMouse.x >= limite_v) {
            if (abs(index - 5.0) < 0.01) {
                mise_a_jour.r = clamp(iMouse.y / iResolution.y, 0.0, 1.0);
            }
        }
    }

    couleur_fragment = mise_a_jour;
}
