#define PI 3.14159265359
#define PI2 6.2831853072

mat2 rotateur(float a) {
    float s = sin(a);
    float c = cos(a);
    return mat2(c, s, -s, c);
}

vec3 palette_couleur(float t, vec3 a, vec3 b, vec3 c, vec3 d) {
    return a + b * cos(PI2 * (c * t + d));
}

float distance_fractale(vec2 p, float m_f, float m_m) {
    float n = floor(3.0 + 8.0 * m_f) + smoothstep(0.6, 1.0, fract(3.0 + 8.0 * m_f));
    vec2 pf = p / iResolution.y * 1.8;
    float s = 1.0;
    for(int i = 0; i < 4; i++) {
        pf = abs(pf);
        if (pf.x < pf.y) pf = pf.yx;
        pf.x = abs(pf.x - 0.333) + 0.333;
        pf *= rotateur(m_m * PI * 0.5);
        float facteur = 1.2 + m_m * 0.5;
        pf = pf * facteur - vec2(0.5, 0.2) * m_m;
        s *= facteur;
    }
    float ang = atan(pf.y, pf.x) + PI;
    float r_poly = PI2 / n;
    float d = cos(floor(0.5 + ang / r_poly) * r_poly - ang) * length(pf);
    return d / s * iResolution.y;
}

float dessiner_curseur_h(vec2 uv, float v, float id) {
    float x = abs(uv.x - (id + 0.5) / 5.0 * 0.9);
    if (x > 0.02 || uv.x > 0.9) return 0.0;
    return smoothstep(0.005, 0.0, x - 0.001) * 0.2 + smoothstep(0.02, 0.0, length(vec2(x, uv.y - v)) - 0.02);
}

float dessiner_curseur_v(vec2 uv, float v) {
    float x = abs(uv.x - 0.95);
    if (x > 0.02) return 0.0;
    return smoothstep(0.005, 0.0, x - 0.001) * 0.2 + smoothstep(0.025, 0.0, length(vec2(x, uv.y - v)) - 0.025);
}

void mainImage(out vec4 couleur_fragment, in vec2 coordonnee_fragment) {
    vec2 uv = coordonnee_fragment / iResolution.xy;
    vec2 tex_el = 1.0 / iResolution.xy;
    
    float p_col = texture(iChannel0, vec2(0.5, 0.5) * tex_el).r;
    float p_cam = texture(iChannel0, vec2(1.5, 0.5) * tex_el).r;
    float p_mor = texture(iChannel0, vec2(2.5, 0.5) * tex_el).r;
    float p_blo = texture(iChannel0, vec2(3.5, 0.5) * tex_el).r;
    float p_vit = texture(iChannel0, vec2(4.5, 0.5) * tex_el).r;
    float p_men = texture(iChannel0, vec2(5.5, 0.5) * tex_el).r;

    float t_anim = iTime * (p_vit * 4.0);
    vec3 accumulation = vec3(0);
    const int iterations = 35;

    for(int i = 0; i < iterations; i++) {
        float f = float(i) / float(iterations - 1);
        float r_couche = (1.1 - f * 0.8) * iResolution.x * 0.35;
        float rot_globale = p_cam * PI2;
        vec2 centre = r_couche * 0.4 * cos(f * 8.0 * vec2(1, 0.8) + t_anim + rot_globale) + iResolution.xy * 0.5;
        vec2 p_local = coordonnee_fragment - centre;
        
        float d = distance_fractale(p_local * rotateur(r_couche / iResolution.x * 6.0 - t_anim + rot_globale), p_mor, p_men);
        float masque = smoothstep(3.0, 0.0, d - r_couche);
        float masque_flou = smoothstep(10.0 * (1.0 - f), 0.0, d - r_couche);
        
        vec3 col = palette_couleur(f + t_anim * 0.05 + p_col, vec3(0.5), vec3(0.5), vec3(1.0), vec3(0, 0.2, 0.5));
        accumulation = mix(accumulation, col * masque * (0.5 + f * 0.5), masque * 0.6 + masque_flou * 0.4);
    }

    vec3 effet_bloom = accumulation * p_blo * 4.0 * smoothstep(0.2, 0.8, length(accumulation));
    vec3 couleur_finale = pow(accumulation + effet_bloom, vec3(0.4545)) * (1.0 - dot(uv - 0.5, uv - 0.5));

    if (uv.y < 0.25 && uv.x < 0.9) {
        vec2 uv_ui = vec2(uv.x, uv.y * 4.0);
        float ui = dessiner_curseur_h(uv_ui, p_col, 0.0) + dessiner_curseur_h(uv_ui, p_cam, 1.0) + 
                   dessiner_curseur_h(uv_ui, p_mor, 2.0) + dessiner_curseur_h(uv_ui, p_blo, 3.0) + 
                   dessiner_curseur_h(uv_ui, p_vit, 4.0);
        couleur_finale = mix(couleur_finale, vec3(1.0), ui);
    }
    if (uv.x >= 0.9) {
        couleur_finale = mix(couleur_finale, vec3(1.0), dessiner_curseur_v(uv, p_men));
    }

    couleur_fragment = vec4(couleur_finale, 1.0);
}

