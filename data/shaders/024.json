  "source": "const vec3 C_NOYAU = vec3(0.05, 0.9, 0.8);\r\nconst vec3 C_LUEUR = vec3(0.0, 0.4, 1.0);\r\nconst vec3 C_LAVE_C = vec3(4.5, 1.2, 0.2);\r\nconst vec3 C_LAVE_B = vec3(1.5, 0.3, 0.05);\r\n\r\nfloat hachage(vec3 p) {\r\n    p = fract(p * 0.3183099 + 0.1);\r\n    p *= 17.0;\r\n    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));\r\n}\r\n\r\nfloat bruit(vec3 x) {\r\n    vec3 i = floor(x);\r\n    vec3 f = fract(x);\r\n    f = f * f * (3.0 - 2.0 * f);\r\n    float n = mix(mix(mix(hachage(i + vec3(0,0,0)), hachage(i + vec3(1,0,0)), f.x),\r\n                   mix(hachage(i + vec3(0,1,0)), hachage(i + vec3(1,1,0)), f.x), f.y),\r\n               mix(mix(hachage(i + vec3(0,0,1)), hachage(i + vec3(1,0,1)), f.x),\r\n                   mix(hachage(i + vec3(0,1,1)), hachage(i + vec3(1,1,1)), f.x), f.y), f.z);\r\n    return n;\r\n}\r\n\r\nfloat mbf(vec3 p, int oct) {\r\n    float v = 0.0;\r\n    float a = 0.5;\r\n    for (int i = 0; i < oct; i++) {\r\n        v += a * bruit(p);\r\n        p *= 2.05;\r\n        a *= 0.5;\r\n    }\r\n    return v;\r\n}\r\n\r\nvec2 trajectoire(float t) {\r\n    vec2 p = vec2(sin(t * 0.6), cos(t * 0.27) * 0.4);\r\n    p += vec2(mbf(vec3(t * 2.2, 1.0, 0.0), 2) - 0.5, \r\n              mbf(vec3(0.0, t * 2.2, 1.0), 2) - 0.5) * 0.24;\r\n    return p;\r\n}\r\n\r\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\r\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\r\n    float t = iTime;\r\n    \r\n    vec2 pos = trajectoire(t);\r\n    vec3 dir = normalize(vec3(uv, 1.1));\r\n    vec3 cam = vec3(0.0, 0.25, -1.5);\r\n    \r\n    float sol_h = -0.65;\r\n    float d_sol = (sol_h - cam.y) / dir.y;\r\n    vec3 col = vec3(0.01, 0.01, 0.02);\r\n    \r\n    if(d_sol > 0.0 && d_sol < 20.0) {\r\n        vec3 p = cam + d_sol * dir;\r\n        float n = mbf(vec3(p.xz * 1.3, t * 0.1), 4);\r\n        float chaud = pow(n, 2.6);\r\n        \r\n        vec3 lave = mix(vec3(0.01), C_LAVE_B, smoothstep(0.1, 0.45, chaud));\r\n        lave = mix(lave, C_LAVE_C, smoothstep(0.45, 0.85, chaud));\r\n        lave *= (1.2 + 0.4 * sin(t * 2.5 + n * 8.0)) * 2.5;\r\n        \r\n        float eclat = exp(-length(p.xz - pos * 2.2) * 1.8);\r\n        lave += C_LUEUR * eclat * 4.0;\r\n        col = mix(col, lave, exp(-d_sol * 0.18));\r\n    }\r\n    \r\n    float d_noyau = length(uv - pos);\r\n    vec3 feu = C_NOYAU * smoothstep(0.045, 0.0, d_noyau) * 2.5;\r\n    feu += C_LUEUR * pow(0.12 / (d_noyau + 0.12), 2.5) * 2.0;\r\n    \r\n    float etincelles = 0.0;\r\n    for(float i=0.0; i<12.0; i++) {\r\n        float vie = fract((t + hachage(vec3(i, 12.0, 5.0)) * 5.0) * 0.6);\r\n        vec2 p_e = trajectoire(t - vie * 0.5) + (vec2(hachage(vec3(i, 0, 0)), hachage(vec3(0, i, 0))) - 0.5) * 0.4;\r\n        etincelles += smoothstep(0.007, 0.0, length(uv - p_e)) * (1.0 - vie);\r\n    }\r\n    \r\n    vec3 final = col + feu + etincelles * C_NOYAU;\r\n    final = 1.0 - exp(-final * 1.3);\r\n    fragColor = vec4(pow(final, vec3(0.75)), 1.0);\r\n}\r\n//*====================================================================================*//\r\n//                                                                                      //\r\n//  _______ _______ _______ _______ _______ _______ _______ _____  _______ ______       //\r\n// |   |   |   ___|_      _|   _   |       __|   |   |   _   |     \\|   ___|   __ \\     //\r\n// |       |   ___| |   | |       |__     |       |       |  --  |   ___|      <        //\r\n// |__|_|__|_______| |___| |___|___|_______|___|___|___|_____/|_______|___|__|          //\r\n//                                                                                      //\r\n//======================================================================================//\r\n//:: [ Optimized for NVIDIA GeForce GeForce GTX 1080 Ti ] ::                            //\r\n//======================================================================================//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░▒░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░▒▒▒▒░░░░░░░░░░░░░░░░ ░░░▒░░░░░░░░░░░░░░░▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░▒▒░░░░░░░░░░░░░░░▒░░░░▒░░▒░░░░░░░░░▒▒░░░░░▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▒░░░░░░░░░░░░░░░░░░░░▒▒▒░░▒▒▒░░▒▒▒▒▒▒▒ ▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░░░░░░░░░  ░░░░░░░░░▒▒▒░▒▒▒▒░░▒▒▒▒▒▒▒▒▒▒▒▒▒ //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▒░░░░░░░░░ ░▒▒▒▒▒░ ░░░░░░░▒░░░░▒░▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//Processeur: AMD Ryzen 9 9950X3D2▒▒▒░ ▒░░░░░░░░░▒▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒▒▒//\r\n//RAM installée 256,0 Go DDR5▒▒▒▒▒▒▒░▒▒▒▒░░░░░ ▒▒▓▒▓▒▒▒▒░░ ░░░░░░░▒▒░░░░░░░░░░░ ▒▒▒▒▒▒▒▒//\r\n//Stockage: Sabrent 16 TB SSD▒▒▒▒▒▒▒░░▒▓▓ ░░░ ▒▒▒▓▓▒▒░▓▒░░ ░░░░░░░▒▒▒▒░░░░░░░░░░░ ▒▒▒▒▒▒//\r\n//Video: NVIDIA GeForce RTX 5090▒▒▒▒▒░▒▓▒▒░░░▒▒▒▒▓▓▓░▓▓ ░░░░░░░░░▒▒▒▒▒▒░░░░░░░ ░░░░▒▒▒▒▒//\r\n//Systeme: Kubuntu/Win11▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▓▒▓▓░▒▒▓▓▓▓▓▓░▓▓ ░ ░░░░░░▒▒▒▒▒▒▒▒░░░▒▒▒▒░░░░░▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▓▒▓▓▒▓▓▓▓▓▓▓▒▒▓▓ ░▒░░░░░░▒▒▒▒▒▒▒▒░▒▒▒▒▒░ ░░░░░▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▓░░░░▒░▓▓▓▓▓▓▓▓▒▒▒░░ ░░░░ ░▒▒▒▒▒▒▒▒░▓▒▒░░░▒▒▒▒▒░░▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ ▓▓▓▓▓▓▓▒░░▒▒▒▒▒▒░░▒▒▒░  ▒ ░▒▒▒▒▒▒░▒▒░ ▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░  ░▒▒▒▒▒▒▒▒▒▒▒▒░ ░░ ▒ ▒▒░ ░▒▒▒░▒▒▒▒▒▒▒▒▒▒▒▒▒▒ //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░  ░▒▒▒▒▒▒▒▒░ ░░░░░▒ ▒▒░░▒▒░░░  ▒▒▒▒▒▒▒▒▒▒▒▒▒  //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░  ░░░░░░░░░░  ░░▒▒▒▒░░ ▒▒▒▒▒▒▒ ▒▒▒▒▒▒▒▒▒▒▒▒ //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░ ░   ░░▒▒▒▒▒▒░▒░░░░▒▒▒▒▒  ░░▒▒▒▒▒▒▒▒▒▒ //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░ ░░     ░░░░░░░░ ░▒▒▒░ ░▒░░░▒░░░ ▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░ ░▒▒▒▒▒▒░░░░░░░░░ ░░ ▒▒▒░░▒▒▒░░░░░░▒▒▒▒▒▒▒▒▒ //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░▒▒▒▒▒▒▒▒░░░░  ░ ░ ░▒▒░░░░░░░░▒▒▒░░░ ▒▒▒