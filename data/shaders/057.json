  "source": "#define PI 3.14159265359\r\n\r\nfloat aleatoire(vec2 st) {\r\n    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);\r\n}\r\n\r\nfloat distHexagone(vec2 p) {\r\n    p = abs(p);\r\n    float c = dot(p, normalize(vec2(1, 1.73)));\r\n    c = max(c, p.x);\r\n    return c;\r\n}\r\n\r\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\r\n    vec2 uv = (fragCoord.xy * 2.0 - iResolution.xy) / iResolution.y;\r\n    vec3 couleur = vec3(0.0);\r\n    \r\n    couleur = mix(vec3(0.0, 0.05, 0.2), vec3(0.1, 0.0, 0.2), length(uv));\r\n    \r\n    float angle = atan(uv.y, uv.x);\r\n    float rayon = length(uv);\r\n    float rayons = sin(angle * 12.0 + iTime * 0.5) * 0.5 + 0.5;\r\n    rayons += sin(angle * 20.0 - iTime * 1.0) * 0.3;\r\n    couleur += vec3(0.0, 0.5, 1.0) * rayons * 0.1 * smoothstep(0.0, 1.0, rayon);\r\n    \r\n    vec2 uvHex = uv * 5.0;\r\n    uvHex.y += iTime * 0.5;\r\n    uvHex.x += sin(uvHex.y * 0.5 + iTime) * 0.5;\r\n    \r\n    vec2 gv = fract(uvHex) - 0.5;\r\n    vec2 id = floor(uvHex);\r\n    \r\n    float dist = distHexagone(gv);\r\n    float taille = aleatoire(id) * 0.4;\r\n    float clignotement = sin(iTime * 3.0 + aleatoire(id) * 10.0) * 0.5 + 0.5;\r\n    \r\n    float hex = smoothstep(taille, taille - 0.05, dist);\r\n    \r\n    vec3 couleurP = vec3(0.0);\r\n    float rnd = aleatoire(id + 1.0);\r\n    if (rnd < 0.33) couleurP = vec3(0.0, 1.0, 1.0);\r\n    else if (rnd < 0.66) couleurP = vec3(1.0, 0.0, 1.0);\r\n    else couleurP = vec3(1.0, 1.0, 0.0);\r\n    \r\n    couleur += couleurP * hex * clignotement * 0.6;\r\n    \r\n    couleur *= 1.0 - dot(uv, uv) * 0.6;\r\n    couleur *= 0.9 + 0.1 * sin(fragCoord.y * 0.5 + iTime * 10.0);\r\n\r\n    fragColor = vec4(couleur, 1.0);\r\n}\r\n//*====================================================================================*//\r\n//                                                                                      //\r\n//  _______ _______ _______ _______ _______ _______ _______ _____  _______ ______       //\r\n// |   |   |   ___|_      _|   _   |       __|   |   |   _   |     \\|   ___|   __ \\     //\r\n// |       |   ___| |   | |       |__     |       |       |  --  |   ___|      <        //\r\n// |__|_|__|_______| |___| |___|___|_______|___|___|___|_____/|_______|___|__|          //\r\n//                                                                                      //\r\n//======================================================================================//\r\n//:: [ Optimized for NVIDIA GeForce GeForce GTX 1080 Ti ] ::                            //\r\n//======================================================================================//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░▒░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░▒▒▒▒░░░░░░░░░░░░░░░░ ░░░▒░░░░░░░░░░░░░░░▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░▒▒░░░░░░░░░░░░░░░▒░░░░▒░░▒░░░░░░░░░▒▒░░░░░▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▒░░░░░░░░░░░░░░░░░░░░▒▒▒░░▒▒▒░░▒▒▒▒▒▒▒ ▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░░░░░░░░░  ░░░░░░░░░▒▒▒░▒▒▒▒░░▒▒▒▒▒▒▒▒▒▒▒▒▒ //\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▒░░░░░░░░░ ░▒▒▒▒▒░ ░░░░░░░▒░░░░▒░▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//Processeur: AMD Ryzen 9 9950X3D2▒▒▒░ ▒░░░░░░░░░▒▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒▒▒//\r\n//RAM installée 256,0 Go DDR5▒▒▒▒▒▒▒░▒▒▒▒░░░░░ ▒▒▓▒▓▒▒▒▒░░ ░░░░░░░▒▒░░░░░░░░░░░ ▒▒▒▒▒▒▒▒//\r\n//Stockage: Sabrent 16 TB SSD▒▒▒▒▒▒▒░░▒▓▓ ░░░ ▒▒▒▓▓▒▒░▓▒░░ ░░░░░░░▒▒▒▒░░░░░░░░░░░ ▒▒▒▒▒▒//\r\n//Video: NVIDIA GeForce RTX 5090▒▒▒▒▒░▒▓▒▒░░░▒▒▒▒▓▓▓░▓▓ ░░░░░░░░░▒▒▒▒▒▒░░░░░░░ ░░░░▒▒▒▒▒//\r\n//Systeme: Kubuntu/Win11▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▓▒▓▓░▒▒▓▓▓▓▓▓░▓▓ ░ ░░░░░░▒▒▒▒▒▒▒▒░░░▒▒▒▒░░░░░▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▓▒▓▓▒▓▓▓▓▓▓▓▒▒▓▓ ░▒░░░░░░▒▒▒▒▒▒▒▒░▒▒▒▒▒░ ░░░░░▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▓░░░░▒░▓▓▓▓▓▓▓▓▒▒▒░░ ░░░░ ░▒▒▒▒▒▒▒▒░▓▒▒░░░▒▒