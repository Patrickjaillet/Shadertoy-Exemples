  "source": "//*====================================================================================*//\r\n//                                                                                      //\r\n//  _______ _______ _______ _______ _______ _______ _______ _____  _______ ______       //\r\n// |   |   |    ___|_     _|   _   |     __|   |   |   _   |     \\|    ___|   __ \\      //\r\n// |       |    ___| |   | |       |__     |       |       |  --  |    ___|      <      //\r\n// |__|_|__|_______| |___| |___|___|_______|___|___|___|___|_____/|_______|___|__|      //\r\n//                                                                                      //\r\n//======================================================================================//\r\n//:: [ GLSL / HLSL / WGSL / MSL / SPIR-V ] ::                                           //\r\n//======================================================================================//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░▒░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░▒▒▒▒░░░░░░░░░░░░░░░░ ░░░▒░░░░░░░░░░░░░░░▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░▒▒░░░░░░░░░░░░░░░▒░░░░▒░░▒░░░░░░░░░▒▒░░░░░▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▒░░░░░░░░░░░░░░░░░░░░▒▒▒░░▒▒▒░░▒▒▒▒▒▒▒ ▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░░░░░░░░░░░░   ░░░░░░░░░▒▒▒░▒▒▒▒░░▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▒░░░░░░░░░ ░▒▒▒▒▒░ ░░░░░░░▒░░░░▒░▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ ░ ▒░░░░░░░░░▒▒▒▒▒▒▒░░░░░░░░░░░░░░░░░░░░░▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▒▒▒░░░░░ ▒▒▓▒▓▒▒▒▒░░ ░░░░░░░▒▒░░░░░░░░░░░ ▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▒▓▓ ░░░ ▒▒▒▓▓▒▒░▓▒░░ ░░░░░░░▒▒▒▒░░░░░░░░░░░ ▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▓▒▒░░░▒▒▒▒▓▓▓░▓▓ ░░░░░░░░░▒▒▒▒▒▒░░░░░░░ ░░░░▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▒▓▒▓▓░▒▒▓▓▓▓▓▓░▓▓ ░ ░░░░░░▒▒▒▒▒▒▒▒░░░▒▒▒▒░░░░░▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░▓▒▓▓▒▓▓▓▓▓▓▓▒▒▓▓ ░▒░░░░░░▒▒▒▒▒▒▒▒░▒▒▒▒▒░ ░░░░░▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░▓░░░░▒░▓▓▓▓▓▓▓▓▒▒▒░░ ░░░░ ░▒▒▒▒▒▒▒▒░▓▒▒░░░▒▒▒▒▒░░▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒ ▓▓▓▓▓▓▓▒░░▒▒▒▒▒▒░░▒▒▒░  ▒ ░▒▒▒▒▒▒░▒▒░ ▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░   ░▒▒▒▒▒▒▒▒▒▒▒▒░ ░░ ▒ ▒▒░ ░▒▒▒░▒▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░    ░▒▒▒▒▒▒▒▒░ ░░░░░▒ ▒▒░░▒▒░░░  ▒▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░   ░░░░░░░░░░  ░░▒▒▒▒░░ ▒▒▒▒▒▒▒ ▒▒▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░ ░    ░░▒▒▒▒▒▒░▒░░░░▒▒▒▒▒  ░░▒▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░ ░░     ░░░░░░░░ ░▒▒▒░ ░▒░░░▒░░░ ▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░ ░▒▒▒▒▒▒░░░░░░░░░ ░░ ▒▒▒░░▒▒▒░░░░░░▒▒▒▒▒▒▒▒▒//\r\n//▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒▒░░░▒▒▒▒▒▒▒▒░░░░  ░ ░ ░▒▒░░░░░░░░▒▒▒░░░ ▒▒▒▒▒▒▒▒//\r\n//======================================================================================//\r\n//:: [ CREDITS ] ::                                                                     //\r\n//======================================================================================//\r\n//  >>  Author  : Patrick JAILLET                                                       //\r\n//  >>  Email   : metashader@proton.me                                                  //\r\n//  >>  Engine  : MetaShader                                                            //\r\n//  >>  URL     : https://0110110101110011.netlify.app                                  //\r\n//*====================================================================================*//\r\n#define AA 1\r\n#define ZERO (min(iFrame,0))\r\n\r\nmat2 rotation(float a) {\r\n    float c = cos(a), s = sin(a);\r\n    return mat2(c, -s, s, c);\r\n}\r\n\r\nvec2 chemin(float z) {\r\n    return vec2(sin(z * 0.2) * 1.5, cos(z * 0.15) * 1.2);\r\n}\r\n\r\nfloat minLissage(float a, float b, float k) {\r\n    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\r\n    return mix(b, a, h) - k * h * (1.0 - h);\r\n}\r\n\r\nfloat carte(vec3 p) {\r\n    vec3 q = p;\r\n    q.xy -= chemin(q.z);\r\n    \r\n    float ang = atan(q.y, q.x);\r\n    float ray = length(q.xy);\r\n    \r\n    float base = 2.5 - ray + 0.3 * sin(q.z * 1.5 - iTime * 1.5) * cos(ang * 6.0 + q.z);\r\n    \r\n    vec3 op = q;\r\n    op.z = mod(op.z + iTime, 3.0) - 1.5;\r\n    float nerv = length(vec2(ray - 2.6, op.z)) - 0.3;\r\n    nerv -= 0.15 * sin(ang * 8.0 + p.z * 2.0);\r\n    \r\n    float d = minLissage(base, nerv, 0.6);\r\n    d -= 0.03 * sin(p.x * 12.0) * sin(p.y * 12.0) * sin(p.z * 12.0);\r\n    \r\n    return d * 0.5;\r\n}\r\n\r\nfloat lancer(vec3 ro, vec3 rd, out float lueur) {\r\n    float t = 0.01;\r\n    lueur = 0.0;\r\n    for (int i = 0; i < 100; i++) {\r\n        float h = carte(ro + rd * t);\r\n        lueur += 0.01 / (0.02 + abs(h));\r\n        if (abs(h) < 0.002 * t || t > 40.0) return (t > 40.0) ? -1.0 : t;\r\n        t += h;\r\n    }\r\n    return -1.0;\r\n}\r\n\r\nvec3 normale(vec3 p) {\r\n    vec2 e = vec2(0.005, 0.0);\r\n    return normalize(vec3(carte(p+e.xyy)-carte(p-e.xyy),\r\n                          carte(p+e.yxy)-carte(p-e.yxy),\r\n                          carte(p+e.yyx)-carte(p-e.yyx)));\r\n}\r\n\r\nfloat occlusion(vec3 p, vec3 n) {\r\n    float occ = 0.0;\r\n    float sca = 1.0;\r\n    for (int i = ZERO; i < 4; i++) {\r\n        float h = 0.06 + 0.12 * float(i);\r\n        float d = carte(p + h * n);\r\n        occ += (h - d) * sca;\r\n        sca *= 0.9;\r\n    }\r\n    return clamp(1.0 - 2.0 * occ, 0.0, 1.0);\r\n}\r\n\r\nvec3 rendu(vec3 ro, vec3 rd) {\r\n    vec3 col = vec3(0.01, 0.03, 0.02);\r\n    float lueur = 0.0;\r\n    float t = lancer(ro, rd, lueur);\r\n    \r\n    if (t > 0.0) {\r\n        vec3 p = ro + rd * t;\r\n        vec3 n = normale(p);\r\n        float occ = occlusion(p, n);\r\n        \r\n        vec3 alb = vec3(0.15, 0.3, 0.15);\r\n        alb += 0.08 * sin(p.z * 3.0) * vec3(0.2, 0.4, 0.1);\r\n        \r\n        vec3 ld = normalize(vec3(0.5, 0.5, 1.0));\r\n        float diff = max(dot(n, ld), 0.0);\r\n        float fres = pow(clamp(1.0 + dot(n, rd), 0.0, 1.0), 3.0);\r\n        \r\n        vec3 ecl = (diff * vec3(0.6, 0.8, 0.5) + 0.1 + fres * vec3(0.3, 0.7, 0.3)) * occ;\r\n        col = alb * ecl;\r\n        \r\n        float brouil = 1.0 - exp(-0.02 * t * t);\r\n        col = mix(col, vec3(0.04, 0.08, 0.06), brouil);\r\n        col += vec3(0.2, 0.5, 0.1) * exp(-0.1 * t) * (1.0 - brouil);\r\n    }\r\n    \r\n    col += vec3(0.2, 0.5, 0.1) * lueur * 0.015;\r\n    return col;\r\n}\r\n\r\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\r\n    vec2 p = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\r\n    float tc = iTime * 1.8;\r\n    \r\n    vec3 ro = vec3(chemin(tc), tc);\r\n    vec3 ta = vec3(chemin(tc + 1.5), tc + 1.5);\r\n    \r\n    vec3 cw = normalize(ta - ro);\r\n    vec3 cp = vec3(sin(iTime * 0.4), cos(iTime * 0.4), 0.0);\r\n    vec3 cu = normalize(cross(cw, cp));\r\n    vec3 cv = cross(cu, cw);\r\n    vec3 rd = mat3(cu, cv, cw) * normalize(vec3(p, 1.4));\r\n\r\n    vec3 col = rendu(ro, rd);\r\n    col = pow(col, vec3(0.4545));\r\n    \r\n    vec2 q = fragCoord / iResolution.xy;\r\n    col *= 0.5 + 0.5 * pow(16.0 * q.x * q.y * (1.0 - q.x) * (1.0 - q.y), 0.25);\r\n    \r\n    fragColor = vec4(col, 1.0);\r\n}"
}