  "source": "/**************************************************************\r\n*  ____    _    _   _ ____  _____ _____   _  ___  ____  ____  *\r\n* / ___|  / \\  | \\ | |  _ \\| ____|  ___| | |/ _ \\|  _ \\|  _ \\ *\r\n* \\___ \\ / _ \\ |  \\| | | | |  _| | |_ _  | | | | | |_) | | | |*\r\n*  ___) / ___ \\| |\\  | |_| | |___|  _| |_| | |_| |  _ <| |_| |*\r\n* |____/_/   \\_\\_| \\_|____/|_____|_|  \\___/ \\___/|_| \\_\\____/ *\r\n***************************************************************\r\n*                 https://x.com/JailletPatrick                *\r\n***************************************************************\r\n*                     Le Petit Editeur GLSL                   *\r\n*   https://github.com/Patrickjaillet/Le-Petit-Editeur-GLSL   *\r\n**************************************************************/\r\nvoid mainImage(out vec4 O, vec2 U) {\r\n    vec2 R = iResolution.xy;\r\n    U = (U + U - R) / R.y * 0.5;\r\n    O -= O;\r\n    for (float t = iTime * 2., i, k, e, d, c, j = 9e2; j-- > 0.;) {\r\n        i = j * 20. / 3.;\r\n        k = 5. * cos(i / 44.);\r\n        e = i / 506. - 15.;\r\n        d = length(vec2(k, e)) / 3.;\r\n        c = d / 2. - t / 3. + mod(i, 2.) * 3.;\r\n        O.rgb += (.5 + .299 * cos(vec3(.1373, 1, .0039) + c + t)) * 2.34e-4 / (length(U - vec2((93.22 + d * d + k * k) * sin(c) + d * d * d / 4. * cos(t * 3. - d * d / 4.), -99. * cos(c / 2.) - 4. * sin(k + k) - i * k * e / 19481. / sin(e / 2.)) / 321.6) + 5e-4);\r\n    }\r\n    O = pow(O, vec4(1.7));\r\n}\r\n/*\r\nhttps://twigl.app?ol=true&ss=-P-E9_o7ugNIq9doZ5jf\r\n---\r\nvec2 U=(FC.xy*2.-r)/r.y*.5;vec4 O;for(float t=t*2.,i,k,e,d,c,j=9e2;j-->0.;\r\n)i=j*20./3.,k=5.*cos(i/44.),e=i/506.-15.,d=length(vec2(k,e))/3.,c=d/2.-t/3.+mod(i,2.)*3.,\r\nO.rgb+=(.5+.299*cos(vec3(.1373,1,.0039)+c+t))*2.34e-4/(length(U-vec2((93.22+d*d+k*k)\r\n*sin(c)+d*d*d/4.*cos(t*3.-d*d/4.),-99.*cos(c/2.)-4.*sin(k+k)-i*k*e/19481./sin(e/2.))/321.6)\r\n+5e-4);o=pow(O,vec4(1.7));\r\n*/"
}