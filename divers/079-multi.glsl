// ==== Buffer A (buffer) ====
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = (fragCoord * 2.0 - iResolution.xy) / iResolution.y;
    float tps = iTime * 0.4;
    
    vec3 couleurAccumulee = vec3(0.0);
    
    for(float i = 0.0; i < 24.0; i++) {
        float phase = i * 1.57;
        vec2 trajectoire = vec2(
            sin(tps + phase * 1.3) * 1.2 + cos(tps * 0.8 + i) * 0.5,
            cos(tps * 1.1 + phase) * 0.7 + sin(tps * 0.5 + i * 1.7) * 0.4
        );
        
        trajectoire *= 0.6;
        
        vec2 d = uv - trajectoire;
        float dist = length(d);
        
        float eclat = 0.0015 / (dist * dist + 0.001);
        eclat += 0.0008 / (dist + 0.005);
        
        vec3 teinte = 0.5 + 0.5 * cos(i + vec3(0.0, 1.0, 2.0) + tps);
        teinte = mix(teinte, vec3(1.0, 0.7, 0.3), 0.8);
        
        couleurAccumulee += teinte * eclat;
    }
    
    vec2 uv_precedent = fragCoord / iResolution.xy;
    vec3 imagePrecedente = texture(iChannel0, uv_precedent).rgb;
    
    couleurAccumulee = mix(couleurAccumulee, imagePrecedente, 0.85);
    
    fragColor = vec4(couleurAccumulee, 1.0);
}
