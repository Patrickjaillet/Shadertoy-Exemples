// ==== Image (image) ====
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    vec2 dcv = (fragCoord * 2.0 - iResolution.xy) / iResolution.y;
    float distCentre = dot(dcv, dcv);
    
    vec3 flouBloom = vec3(0.0);
    float poids = 0.0;
    for(float i = -3.0; i <= 3.0; i++) {
        for(float j = -3.0; j <= 3.0; j++) {
            vec2 decal = vec2(i, j) * 0.004;
            vec3 echantillon = texture(iChannel0, uv + decal).rgb;
            float p = exp(-(i*i + j*j) * 0.2);
            flouBloom += pow(max(echantillon, vec3(0.0)), vec3(1.5)) * p;
            poids += p;
        }
    }
    flouBloom /= poids;
    
    vec3 final;
    float intensite = 0.01 * distCentre;
    final.r = texture(iChannel0, uv + vec2(intensite, 0.0)).r;
    final.g = texture(iChannel0, uv).g;
    final.b = texture(iChannel0, uv - vec2(intensite, 0.0)).b;
    
    final += flouBloom * 0.6;
    
    final = mix(final, vec3(1.1, 0.8, 0.5) * dot(final, vec3(0.33)), 0.2);
    
    final = pow(max(final, vec3(0.0)), vec3(0.8));
    final = smoothstep(vec3(-0.05), vec3(1.15), final);
    final = pow(max(final, vec3(0.0)), vec3(1.0 / 2.2));
    
    float vignetage = smoothstep(1.8, 0.5, distCentre);
    final *= vignetage;
    
    float grain = (hachage22(uv + iTime).x - 0.5) * 0.04;
    final += grain;
    
    fragColor = vec4(final, 1.0);
}
