// ==== Common (common) ====
mat2 rotation(float a) {
    float s = sin(a);
    float c = cos(a);
    return mat2(c, -s, s, c);
}

vec2 hachage22(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(443.897, 441.423, 437.195));
    p3 += dot(p3, p3.yzx + 19.19);
    return fract((p3.xx + p3.yz) * p3.zy);
}

float bruit(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(dot(hachage22(i + vec2(0.0,0.0)), f - vec2(0.0,0.0)),
                   dot(hachage22(i + vec2(1.0,0.0)), f - vec2(1.0,0.0)), u.x),
               mix(dot(hachage22(i + vec2(0.0,1.0)), f - vec2(0.0,1.0)),
                   dot(hachage22(i + vec2(1.0,1.0)), f - vec2(1.0,1.0)), u.x), u.y);
}
